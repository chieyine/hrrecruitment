  decisionComment   String?
  dueAt             DateTime
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, dueAt])
}

model ComplaintCase {
  id                    String                @id @default(uuid())
  referenceNumber       String                @unique
  reporterUserId        String?
  reporterEmail         String?
  applicationId         String?
  application           Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  category              String // COMPLAINT, APPEAL, SAFEGUARDING, FRAUD, ACCOMMODATION, PRIVACY, OTHER
  subject               String
  description           String
  confidentiality       String                @default("CONFIDENTIAL")
  status                String                @default("RECEIVED") // RECEIVED, TRIAGED, INVESTIGATING, AWAITING_INFORMATION, RESOLVED, CLOSED
  priority              String                @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  assignedToUserId      String?
  acknowledgementSentAt DateTime?
  dueAt                 DateTime?
  resolution            String?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lockVersion           Int                   @default(1)
  comments              ComplaintComment[]
  attachments           ComplaintAttachment[]

  @@index([status, priority, dueAt])
  @@index([reporterUserId])
}

model ComplaintComment {
  id              String        @id @default(uuid())
  complaintCaseId String
  complaintCase   ComplaintCase @relation(fields: [complaintCaseId], references: [id], onDelete: Cascade)
  authorUserId    String?
  body            String
  internalOnly    Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

model ComplaintAttachment {
  id              String        @id @default(uuid())
  complaintCaseId String
  complaintCase   ComplaintCase @relation(fields: [complaintCaseId], references: [id], onDelete: Cascade)
  fileAssetId     String
  uploadedBy      String?
  createdAt       DateTime      @default(now())
}

model EntityVersion {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  version      Int
  snapshotJson String
  changeReason String?
  createdBy    String
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, version])
}

/// §11.1 A vacancy-specific longlisting rule. `ruleType` covers the full list in
/// §11.1; `classification` is the §11.2 marking that decides whether failure is
/// fatal, scored, preferred, or purely informational.
model EligibilityRule {
  id        String  @id @default(uuid())
  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  ruleType String
  // MINIMUM_QUALIFICATION, REQUIRED_FIELD_OF_STUDY, MINIMUM_EXPERIENCE,
  // MINIMUM_NGO_EXPERIENCE, MINIMUM_TECHNICAL_EXPERIENCE, REQUIRED_LICENCE,
  // REQUIRED_CERTIFICATION, REQUIRED_LANGUAGE, DUTY_STATION_ACCEPTANCE,
  // WORK_AUTHORISATION, REQUIRED_COMPUTER_SKILL, REQUIRED_SECTOR_EXPERIENCE,
  // MINIMUM_MANAGEMENT_EXPERIENCE, AVAILABILITY_BEFORE, WILLINGNESS_TO_TRAVEL,
  // MANDATORY_DOCUMENT, MANDATORY_QUESTION, REQUIRED_ANSWER

  /// §11.2 MANDATORY_KNOCKOUT, SCORED, PREFERRED, INFORMATIONAL
  classification String @default("MANDATORY_KNOCKOUT")

  label          String
  field          String?
  operator       String  @default("GTE") // GTE, LTE, EQUALS, IN, CONTAINS, TRUE, BEFORE, AFTER, EXISTS
  expectedJson   String
  failureMessage String

  /// Weight applied when `classification = SCORED` (§11.3 step 4).
  weight Decimal @default(0) @db.Decimal(6, 2)

  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// §11.7 rule changes after publication are approved and diffed, never silent.
  changes EligibilityRuleChange[]

  @@index([vacancyId, active, displayOrder])
}

/// §11.7 An auditable before/after record of a rule change made once the vacancy
/// was already published. Requires HR Manager approval and flags fairness review
/// when applications had already been received.
model EligibilityRuleChange {
  id     String          @id @default(uuid())
  ruleId String
  rule   EligibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  vacancyId      String
  changeType     String // CREATE, UPDATE, DEACTIVATE
  previousJson   String?
  proposedJson   String
  reason         String
  requestedBy    String
  requestedAt    DateTime  @default(now())
  approvalId     String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedBy      String?
  decidedAt      DateTime?

  /// True when applications already existed at the time of the change (§11.7).
  fairnessReviewRequired Boolean @default(false)
  fairnessReviewNote     String?
  applicationsAtChange   Int     @default(0)

  @@index([vacancyId, status])
  @@index([ruleId, requestedAt])
}

/// §11.3 One automatic longlisting pass over a vacancy's applications, and the
/// §11.8 summary it produces. Confirming a run is what turns a proposed longlist
/// into the confirmed longlist.
model LonglistRun {
  id        String  @id @default(uuid())
  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  trigger String // DEADLINE_CLOSE, ON_ARRIVAL, MANUAL, RERUN
  status  String @default("IN_PROGRESS") // IN_PROGRESS, AWAITING_CONFIRMATION, CONFIRMED, SUPERSEDED

  /// §11.8 output counters
  totalApplications      Int @default(0)
  completeApplications   Int @default(0)
  incompleteApplications Int @default(0)
  automaticallyEligible  Int @default(0)
  automaticallyIneligible Int @default(0)
  requiresReview         Int @default(0)
  duplicateApplications  Int @default(0)
  withdrawnApplications  Int @default(0)

  /// Distribution of failure reasons, keyed by rule id (§11.8).
  reasonDistributionJson String @default("{}")
  /// Snapshot of the rule set used, so the run stays reproducible.
  ruleSnapshotJson       String @default("[]")

  startedBy   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// §11.8 longlisting approval record
  confirmedBy   String?
  confirmedAt   DateTime?
  confirmationNote String?

  evaluations EligibilityEvaluation[]

  @@index([vacancyId, startedAt])
  @@index([status, startedAt])
}

/// §11.3 The result of evaluating one application against the approved rules.
model EligibilityEvaluation {
  id            String  @id @default(uuid())
  applicationId String
  longlistRunId String?
  longlistRun   LonglistRun? @relation(fields: [longlistRunId], references: [id], onDelete: SetNull)

  ruleVersionJson String
  /// Per-rule outcome: MET, NOT_MET, UNCLEAR, NOT_APPLICABLE (§11.3 step 3).
  resultJson      String

  /// §11.3 step 4 approved eligibility score, when scored rules are configured.
  eligibilityScore    Decimal? @db.Decimal(6, 2)
  maximumScore        Decimal? @db.Decimal(6, 2)

  /// §11.4 AUTOMATICALLY_ELIGIBLE, AUTOMATICALLY_INELIGIBLE, REQUIRES_REVIEW,
  /// DUPLICATE_APPLICATION, INCOMPLETE_APPLICATION, WITHDRAWN
  suggestedOutcome String
  /// Preserved even after an override, so §11.6 can show the original result.
  originalOutcome  String

  /// The rule that decided the outcome (§11.3 step 8).
  decidingRuleId String?

  humanDecision  String?
  decidedBy      String?
  decisionReason String?
  /// §11.6 override controls
  overrideReasonCode String?
  overrideEvidenceFileId String?
  overrideApprovalId String?

  evaluatedAt DateTime  @default(now())
  decidedAt   DateTime?

  @@index([applicationId, evaluatedAt])
  @@index([longlistRunId, suggestedOutcome])
}

model OperationalEvent {
  id           String    @id @default(uuid())
  eventType    String
  severity     String    @default("INFO")
  resourceType String?
  resourceId   String?
  detailsJson  String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType, createdAt])
  @@index([resolvedAt, severity])
}

model JobRun {
  id          String    @id @default(uuid())
  jobName     String
  status      String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summaryJson String?
  error       String?

  @@index([jobName, startedAt])
}

model JobLease {
  jobName     String   @id
  leaseOwner  String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model RateLimitBucket {
  keyHash     String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model ScheduledReport {
  id             String    @id @default(uuid())
  userId         String
  reportType     String
  format         String    @default("xlsx")
  frequency      String // DAILY, WEEKLY, MONTHLY
  recipientEmail String
  nextRunAt      DateTime
  lastRunAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, nextRunAt])
  @@index([userId])
}
