// ----------------------------------------------------
// 19. Readiness, Resumption & ERP Transfer
// ----------------------------------------------------

model ReadinessCheck {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  checkType              String // OFFER_ACCEPTED, ID_APPROVED, QUALIFICATION_APPROVED, FORMS_APPROVED, POLICIES_SIGNED, COURSES_COMPLETED, TASKS_COMPLETED, REFERENCES_SATISFACTORY, HR_REVIEW
  required               Boolean              @default(true)
  status                 String               @default("PENDING") // PENDING, PASSED, FAILED, WAIVED
  sourceResourceType     String?
  sourceResourceId       String?
  waivedBy               String?
  waiverReason           String?
  waivedAt               DateTime?
  reviewedAt             DateTime?

  @@unique([candidatePreboardingId, checkType])
}

model ReadinessConfirmation {
  id                     String               @id @default(uuid())
  candidatePreboardingId String               @unique
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  confirmedBy            String
  confirmedAt            DateTime             @default(now())
  status                 String               @default("CONFIRMED")
  summaryJson            String
  comment                String?
}

model ResumptionRecord {
  id                     String      @id @default(uuid())
  applicationId          String      @unique
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plannedStartDate       DateTime
  actualStartDate        DateTime?
  reportingLocation      String
  outcome                String      @default("PENDING") // RESUMED, DID_NOT_RESUME, POSTPONED, WITHDRAWN
  confirmedBy            String?
  supervisorConfirmation Boolean     @default(false)
  comment                String?
}

model ERPTransferRecord {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Null until the ERP has actually issued a number. This field holds only a
  /// real personnel number — workflow state lives in `transferStatus`, never in
  /// a placeholder written here.
  erpPersonnelNumber String? @unique

  /// §19.1 / §19.4 APPROVED once an HR manager has released the transfer,
  /// RECORDED once the ERP number is keyed back in, CONFIRMED after reconciliation.
  transferStatus String @default("APPROVED") // APPROVED, RECORDED, CONFIRMED, CANCELLED

  /// Set when the number is recorded, not when approval is granted.
  createdInErpAt DateTime?
  recordedBy     String?
  comment        String?
  status         String    @default("CREATED_IN_ERP") // retained for existing readers

  /// §19.1 HR Manager approval is required before the handover pack is issued.
  approvedBy       String?
  approvedAt       DateTime?
  /// §19.3 the generated handover PDF containing the §19.2 dataset.
  handoverPackFileId String?
  handoverPackFile   FileAsset? @relation("ErpHandoverPack", fields: [handoverPackFileId], references: [id])
  handoverPackGeneratedAt DateTime?
  /// Snapshot of exactly what was handed over, for audit reconstruction.
  transferredDataJson String?
  /// §19.3 duplicate employee check outcome recorded before the pack is issued.
  duplicateCheckStatus String  @default("NOT_RUN") // NOT_RUN, CLEAR, POSSIBLE_DUPLICATE, OVERRIDDEN
  duplicateCheckNote   String?
}

// ----------------------------------------------------
// 19a. Background & Due-Diligence Checks (§16, §28.11)
// ----------------------------------------------------

/// A structured due-diligence check on a candidate. Findings are restricted:
/// ordinary panel members must never see them (§16).
model BackgroundCheck {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  checkType String
  // IDENTITY, QUALIFICATION, EMPLOYMENT, PROFESSIONAL_LICENCE, CRIMINAL_RECORD,
  // SANCTIONS_SCREENING, SAFEGUARDING, WORK_AUTHORISATION, DRIVING_LICENCE

  status String @default("NOT_REQUESTED")
  // NOT_REQUESTED, REQUESTED, IN_PROGRESS, RECEIVED, CLEARED, CONCERNS_RAISED,
  // FAILED, WAIVED, NOT_APPLICABLE

  /// §28.11 the approved third-party provider, when one is used.
  providerName      String?
  providerReference String?
  /// Only the necessary information is transmitted (§28.11).
  submittedFieldsJson String?

  requestedBy String?
  requestedAt DateTime?
  receivedAt  DateTime?

  outcome         String? // CLEAR, ADVERSE, INCONCLUSIVE
  /// Restricted finding detail. Never exposed to panel members or the candidate.
  findingSummary  String?
  restrictedNote  String?
  evidenceFileId  String?
  evidenceFile    FileAsset? @relation("BackgroundCheckEvidence", fields: [evidenceFileId], references: [id])

  reviewedBy String?
  reviewedAt DateTime?

  /// A waived check needs an explicit reason and approver (§18).
  waivedBy     String?
  waivedReason String?

  lawfulBasis String? // Some checks are only lawful in certain jurisdictions (§16).
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, checkType])
  @@index([status, checkType])
}

// ----------------------------------------------------
// 19b. CV Parsing (§28.1)
// ----------------------------------------------------

/// Structured information extracted from an uploaded CV. Parsing only organises
/// information — it never decides suitability, and the candidate must review and
/// correct it before the application is submitted (§28.1).
model CvParseResult {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileAssetId String
  fileAsset   FileAsset        @relation("CvParseSource", fields: [fileAssetId], references: [id], onDelete: Cascade)

  status String @default("PENDING") // PENDING, PARSED, FAILED, ACCEPTED, DISCARDED

  /// The raw extracted draft, before any candidate correction.
  extractedJson String @default("{}")
  /// What the candidate accepted after review, if anything.
  acceptedJson  String?

  parserVersion String  @default("heuristic-1")
  confidence    Decimal @default(0) @db.Decimal(4, 3)
  failureReason String?

  parsedAt   DateTime  @default(now())
  reviewedAt DateTime?

  @@index([candidateId, parsedAt])
}

// ----------------------------------------------------
// 19c. Electronic Signatures (§28.10)
// ----------------------------------------------------

/// A secure electronic approval or signature over a versioned record. Used for
/// every document class listed in §28.10.
model ElectronicSignature {
  id           String @id @default(uuid())
  resourceType String
  // STAFFING_REQUEST, VACANCY_APPROVAL, CONFLICT_DECLARATION, SHORTLIST_APPROVAL,
  // INTERVIEW_SCORECARD, SELECTION_RECOMMENDATION, REFERENCE_FORM, OFFER_APPROVAL,
  // CONDITIONAL_OFFER, FINAL_OFFER, CANDIDATE_ACCEPTANCE, PREEMPLOYMENT_DECLARATION,
  // ERP_TRANSFER_APPROVAL, RECRUITMENT_CLOSURE
  resourceId   String

  signatoryUserId String?
  signatoryName   String
  signatoryEmail  String?
  signatoryRole   String?

  /// §28.10 record: document version, method, status, and any later amendment.
  documentVersion  Int    @default(1)
  documentHash     String
  signatureMethod  String // TYPED_NAME, DRAWN_SIGNATURE, UPLOADED_PDF, APPROVAL_CLICK
  authenticationMethod String @default("SESSION") // SESSION, MFA, EMAIL_TOKEN, SSO
  status           String @default("SIGNED") // SIGNED, DECLINED, AMENDED, VOIDED

  drawnSignatureData String?
  signedFileId       String?
  signedFile         FileAsset? @relation("ElectronicSignatureFile", fields: [signedFileId], references: [id])

  ipAddress String?
  userAgent String?
  signedAt  DateTime @default(now())

  amendedBySignatureId String?
  amendmentReason      String?

  @@index([resourceType, resourceId, signedAt])
  @@index([signatoryUserId, signedAt])
}

