  displayName       String
  status            String    @default("DISCONNECTED") // DISCONNECTED, CONNECTED, ERROR, EXPIRED
  configurationJson String    @default("{}")
  secretReference   String?
  lastHealthCheckAt DateTime?
  lastHealthStatus  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  identities IntegrationIdentity[]

  @@unique([provider, connectionType])
}

/// §28.15 A single user's OAuth grant against a calendar or meeting provider.
/// Tokens are sealed with lib/secret-box before they touch the database.
model IntegrationIdentity {
  id           String                @id @default(uuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerAccountId String
  providerEmail     String?
  scopesJson        String  @default("[]")

  /// Sealed token material. Never stored or logged in plaintext.
  accessTokenSealed  String
  refreshTokenSealed String?
  accessTokenExpiresAt DateTime?

  status       String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, ERROR
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([connectionId, userId])
  @@index([userId, status])
}

/// §28.15 Transient state for an in-flight OAuth authorisation, including the
/// PKCE verifier. Short-lived and single-use.
model IntegrationOAuthState {
  id             String    @id @default(uuid())
  state          String    @unique
  userId         String
  provider       String
  connectionType String
  /// Sealed with lib/secret-box, like the tokens it will be exchanged for. The
  /// verifier is the secret half of the PKCE pair; storing it in clear would
  /// undermine the protection PKCE exists to give.
  codeVerifierSealed String
  redirectPath   String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// §28.15 Panel and candidate availability used to propose interview slots.
