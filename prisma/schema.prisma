// FRAD Recruitment and Preboarding Platform Schema
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Identity & Permissions
// ----------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?
  passwordHash    String
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  accountStatus   String    @default("ACTIVE") // ACTIVE, LOCKED, SUSPENDED, MERGED
  sessionVersion  Int       @default(1)
  lastLoginAt     DateTime?

  // Automatic lockout. `lockedUntil` expires on its own so a locked-out user
  // recovers without an administrator, while `accountStatus = LOCKED` remains
  // the manual, indefinite lock an administrator applies.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  // Multi-factor authentication (TOTP, RFC 6238).
  mfaEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles             UserRole[]
  candidateProfile      CandidateProfile?
  auditLogs             AuditLog[]             @relation("ActorAuditLogs")
  applicationNotes      ApplicationNote[]
  scorecards            CandidateScorecard[]
  conflictDeclarations  ConflictDeclaration[]
  interviewPanels       InterviewPanelMember[]
  createdVacancies      Vacancy[]              @relation("VacancyOwner")
  sentMessages          Message[]
  notifications         Notification[]
  externalIdentities    ExternalIdentity[]
  assignedWorkItems     WorkItem[]             @relation("WorkItemAssignee")
  createdWorkItems      WorkItem[]             @relation("WorkItemCreator")
  talentPoolMemberships TalentPoolMember[]     @relation("TalentPoolAddedBy")
  mfaSecret             UserMfaSecret?
  recoveryCodes         UserRecoveryCode[]
  sessions              UserSession[]
  savedSearches         SavedSearch[]
}

/// TOTP shared secret. One per user; replaced wholesale on re-enrolment.
model UserMfaSecret {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base32 secret, encrypted at rest with the storage key.
  secretCipher String
  /// Set once the user proves possession with a valid code.
  confirmedAt  DateTime?
  /// Guards against replay of the same 30-second step.
  lastUsedStep BigInt?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Single-use MFA recovery codes, stored only as SHA-256 hashes.
model UserRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId])
}

/// One row per signed-in device, so a single session can be revoked without
/// invalidating every other device via sessionVersion.
model UserSession {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JWT `jti`; the session token carries this and it is checked on every request.
  tokenId        String    @unique
  sessionVersion Int
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// A candidate's saved vacancy search, optionally emailed when new matches open.
model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Serialised filter set: search text, departmentId, dutyStationId, contractType.
  criteriaJson  String
  alertsEnabled Boolean   @default(true)
  frequency     String    @default("DAILY") // DAILY, WEEKLY
  lastRunAt     DateTime?
  lastAlertAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([alertsEnabled, lastRunAt])
}

model ExternalIdentity {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer      String
  subject     String
  emailAtLink String
  linkedAt    DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([issuer, subject])
  @@index([userId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique // PUBLIC, CANDIDATE, RECRUITMENT_OFFICER, HR_MANAGER, HIRING_MANAGER, PANEL_MEMBER, APPROVER, COURSE_ADMIN, SYSTEM_ADMIN, AUDITOR
  description     String?
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. vacancy.create.all, application.read.assigned
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  scopeType String? // GLOBAL, DEPARTMENT, VACANCY, DUTY_STATION
  scopeId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
}

// ----------------------------------------------------
// 2. Candidate Profile
// ----------------------------------------------------

model CandidateProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalFirstName              String
  middleName                  String?
  lastName                    String
  preferredName               String?
  nationality                 String?
  countryOfResidence          String?
  state                       String?
  lga                         String?
  city                        String?
  address                     String?
  primaryPhone                String?
  alternatePhone              String?
  preferredContactMethod      String?   @default("EMAIL")
  willingnessToRelocate       Boolean   @default(false)
  preferredDutyLocationsJson  String?
  earliestStartDate           DateTime?
  profileCompletionPercentage Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  education             CandidateEducation[]
  employment            CandidateEmployment[]
  licences              CandidateLicence[]
  certifications        CandidateCertification[]
  skills                CandidateSkill[]
  languages             CandidateLanguage[]
  documents             CandidateDocument[]
  applications          Application[]
  consentRecords        ConsentRecord[]
  deletionRequests      DataDeletionRequest[]
  talentPoolMemberships TalentPoolMember[]
}

model ConsentRecord {
  id            String           @id @default(uuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  consentType   String
  noticeVersion String
  decision      Boolean
  decidedAt     DateTime         @default(now())
  withdrawnAt   DateTime?
}

model DataDeletionRequest {
  id                       String           @id @default(uuid())
  candidateId              String
  candidate                CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status                   String           @default("PENDING")
  reason                   String?
  requestedAt              DateTime         @default(now())
  decidedBy                String?
  decidedAt                DateTime?
  legalOverrideRequestedBy String?
  legalOverrideApprovedBy  String?
}

model CandidateEducation {
  id                 String           @id @default(uuid())
  candidateId        String
  candidate          CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution        String
  qualification      String
  fieldOfStudy       String
  country            String
  startYear          Int
  completionYear     Int?
  isCurrent          Boolean          @default(false)
  grade              String?
  certificateFileId  String?
  verificationStatus String           @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REJECTED
  verifiedBy         String?
  verifiedAt         DateTime?
}

model CandidateEmployment {
  id                  String           @id @default(uuid())
  candidateId         String
  candidate           CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employer            String
  jobTitle            String
  employmentType      String
  country             String
  state               String?
  location            String?
  startDate           DateTime
  endDate             DateTime?
  isCurrent           Boolean          @default(false)
  responsibilities    String?
  reasonForLeaving    String?
  supervisorName      String?
  supervisorEmail     String?
  supervisorPhone     String?
  permissionToContact Boolean          @default(true)
}

model CandidateLicence {
  id                 String           @id @default(uuid())
  candidateId        String
  candidate          CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  professionalBody   String
  licenceType        String
  licenceNumber      String
  issueDate          DateTime
  expiryDate         DateTime?
  evidenceFileId     String?
  verificationStatus String           @default("UNVERIFIED")
  verifiedBy         String?
  verifiedAt         DateTime?
}

model CandidateCertification {
  id               String           @id @default(uuid())
  candidateId      String
  candidate        CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name             String
  issuingBody      String
  credentialNumber String?
  issueDate        DateTime?
  expiryDate       DateTime?
  fileId           String?
}

model CandidateSkill {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  proficiency String? // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
}

model CandidateLanguage {
  id            String           @id @default(uuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language      String
  speakingLevel String // BASIC, FLUENT, NATIVE
  readingLevel  String
  writingLevel  String
}

// ----------------------------------------------------
// 3. File Storage & Documents
// ----------------------------------------------------

model FileAsset {
  id               String   @id @default(uuid())
  ownerUserId      String
  storageKey       String
  originalName     String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  virusScanStatus  String   @default("CLEAN") // CLEAN, PENDING, INFECTED
  encryptionStatus String   @default("ENCRYPTED")
  sensitivityClass String   @default("STANDARD") // STANDARD, CONFIDENTIAL, RESTRICTED
  createdAt        DateTime @default(now())

  candidateDocuments CandidateDocument[]
  applicationFiles   ApplicationFile[]
}

model CandidateDocument {
  id              String           @id @default(uuid())
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileAssetId     String
  fileAsset       FileAsset        @relation(fields: [fileAssetId], references: [id])
  documentType    String // CV, COVER_LETTER, CERTIFICATE, NYSC, PASSPORT_PHOTO, GUARANTOR_FORM, ETC.
  expiryDate      DateTime?
  status          String           @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
}

// ----------------------------------------------------
// 4. Vacancies & Config
// ----------------------------------------------------

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  active    Boolean   @default(true)
  vacancies Vacancy[]
}

model VacancyCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  active    Boolean   @default(true)
  vacancies Vacancy[]
}

model Project {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  active    Boolean   @default(true)
  vacancies Vacancy[]
}

model DutyStation {
  id        String    @id @default(uuid())
  name      String
  state     String
  lga       String?
  address   String?
  active    Boolean   @default(true)
  vacancies Vacancy[]
}

model Vacancy {
  id                           String           @id @default(uuid())
  referenceNumber              String           @unique
  title                        String
  departmentId                 String
  department                   Department       @relation(fields: [departmentId], references: [id])
  projectId                    String?
  project                      Project?         @relation(fields: [projectId], references: [id])
  categoryId                   String?
  category                     VacancyCategory? @relation(fields: [categoryId], references: [id])
  dutyStationId                String
  dutyStation                  DutyStation      @relation(fields: [dutyStationId], references: [id])
  numberOfPositions            Int              @default(1)
  contractType                 String // PERMANENT, FIXED_TERM, TEMPORARY, CONSULTANT, INTERN, VOLUNTEER
  contractDuration             String?
  reportingLine                String?
  summary                      String
  responsibilities             String
  essentialQualifications      String
  desirableQualifications      String?
  minimumExperienceYears       Int              @default(0)
  desiredExperience            String?
  languageRequirements         String?
  technicalSkills              String?
  behaviouralCompetencies      String?
  safeguardingResponsibilities String?
  travelRequirement            String?
  openingAt                    DateTime
  closingAt                    DateTime
  status                       String           @default("DRAFT") // DRAFT, PENDING_APPROVAL, SCHEDULED, OPEN, PAUSED, CLOSED, CANCELLED, COMPLETED, ARCHIVED
  ownerUserId                  String
  owner                        User             @relation("VacancyOwner", fields: [ownerUserId], references: [id])

  screeningScorecardTemplateId String?
  interviewScorecardTemplateId String?
  preboardingPackageId         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lockVersion Int      @default(1)

  questions         VacancyQuestion[]
  requiredDocuments VacancyRequiredDocument[]
  applications      Application[]
  assessments       Assessment[]
}

model VacancyQuestion {
  id                String  @id @default(uuid())
  vacancyId         String
  vacancy           Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fieldType         String // TEXT, LONGTEXT, NUMBER, DATE, YESNO, SELECT, MULTISELECT, FILE, DECLARATION
  label             String
  helpText          String?
  required          Boolean @default(true)
  configurationJson String?
  conditionJson     String?
  displayOrder      Int     @default(0)

  answers          ApplicationAnswer[]
  applicationFiles ApplicationFile[]
}

model VacancyRequiredDocument {
  id               String  @id @default(uuid())
  vacancyId        String
  vacancy          Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  documentType     String
  required         Boolean @default(true)
  allowedFileTypes String  @default("pdf,jpg,png")
  maximumFileSize  Int     @default(5242880) // 5MB default
  expiryRequired   Boolean @default(false)
}

// ----------------------------------------------------
// 5. Applications
// ----------------------------------------------------

model Application {
  id              String           @id @default(uuid())
  referenceNumber String?          @unique
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId       String
  vacancy         Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  internalStatus         String @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, LONGLISTED, INELIGIBLE, SHORTLISTED, ASSESSMENT_INVITED, ASSESSMENT_COMPLETED, INTERVIEW_INVITED, INTERVIEW_COMPLETED, REFERENCE_CHECK, RECOMMENDED, RESERVE, NOT_SELECTED, OFFER_DRAFT, OFFER_SENT, OFFER_ACCEPTED, PREBOARDING, READY_TO_RESUME, RESUMED, TRANSFERRED_TO_ERP, WITHDRAWN, CANCELLED
  candidateVisibleStatus String @default("APPLICATION_DRAFT")

  submittedAt        DateTime?
  assignedReviewerId String?
  eligibilityResult  String?
  screeningScore     Float?
  assessmentScore    Float?
  interviewScore     Float?
  finalScore         Float?
  recommendation     String?
  referenceStatus    String    @default("NOT_REQUIRED")
  offerStatus        String?
  preboardingStatus  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lockVersion Int      @default(1)

  answers               ApplicationAnswer[]
  files                 ApplicationFile[]
  notes                 ApplicationNote[]
  stageHistory          ApplicationStageHistory[]
  snapshots             ApplicationProfileSnapshot[]
  scorecards            CandidateScorecard[]
  conflictDeclarations  ConflictDeclaration[]
  candidateAssessments  CandidateAssessment[]
  interviews            Interview[]
  referees              Referee[]
  selectionDecisions    SelectionDecision[]
  offers                Offer[]
  preboardings          CandidatePreboarding[]
  resumptionRecord      ResumptionRecord?
  erpTransferRecord     ERPTransferRecord?
  messageThreads        MessageThread[]
  accommodationRequests AccommodationRequest[]
  complaintCases        ComplaintCase[]

  @@unique([candidateId, vacancyId])
}

model ApplicationProfileSnapshot {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  profileJson   String
  createdAt     DateTime    @default(now())
}

model ApplicationAnswer {
  id                String          @id @default(uuid())
  applicationId     String
  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyQuestionId String
  vacancyQuestion   VacancyQuestion @relation(fields: [vacancyQuestionId], references: [id])
  answerJson        String
}

model ApplicationFile {
  id                        String           @id @default(uuid())
  applicationId             String
  application               Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyQuestionId         String?
  vacancyQuestion           VacancyQuestion? @relation(fields: [vacancyQuestionId], references: [id])
  vacancyRequiredDocumentId String?
  fileAssetId               String
  fileAsset                 FileAsset        @relation(fields: [fileAssetId], references: [id])
}

model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User        @relation(fields: [authorUserId], references: [id])
  category      String      @default("GENERAL") // GENERAL, SCREENING, ASSESSMENT, INTERVIEW, REFERENCE, PREBOARDING, RESTRICTED
  content       String
  restricted    Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model ApplicationStageHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  changedBy     String
  reason        String?
  createdAt     DateTime    @default(now())
}

// ----------------------------------------------------
// 6. Scorecards & Screening
// ----------------------------------------------------

model ScorecardTemplate {
  id            String               @id @default(uuid())
  name          String
  scorecardType String // SCREENING, INTERVIEW
  description   String?
  version       Int                  @default(1)
  active        Boolean              @default(true)
  criteria      ScorecardCriterion[]
  scorecards    CandidateScorecard[]
}

model ScorecardCriterion {
  id                  String            @id @default(uuid())
  scorecardTemplateId String
  scorecardTemplate   ScorecardTemplate @relation(fields: [scorecardTemplateId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  maximumScore        Float
  weight              Float             @default(1.0)
  required            Boolean           @default(true)
  minimumScore        Float?
  guidance            String?
  commentRequired     Boolean           @default(false)
  displayOrder        Int               @default(0)

  scores CandidateCriterionScore[]
}

model CandidateScorecard {
  id                   String            @id @default(uuid())
  applicationId        String
  application          Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecardTemplateId  String
  scorecardTemplate    ScorecardTemplate @relation(fields: [scorecardTemplateId], references: [id])
  reviewerUserId       String
  reviewer             User              @relation(fields: [reviewerUserId], references: [id])
  status               String            @default("DRAFT") // DRAFT, SUBMITTED, REOPENED
  totalScore           Float             @default(0)
  submittedAt          DateTime?
  reopenedBy           String?
  reopenedAt           DateTime?
  reopenReason         String?
  templateSnapshotJson String?
  version              Int               @default(1)
  previousVersionsJson String            @default("[]")

  criterionScores CandidateCriterionScore[]

  @@unique([applicationId, scorecardTemplateId, reviewerUserId])
}

model CandidateCriterionScore {
  id                   String             @id @default(uuid())
  candidateScorecardId String
  candidateScorecard   CandidateScorecard @relation(fields: [candidateScorecardId], references: [id], onDelete: Cascade)
  criterionId          String
  criterion            ScorecardCriterion @relation(fields: [criterionId], references: [id])
  score                Float
  comment              String?
  evidence             String?

  @@unique([candidateScorecardId, criterionId])
}

model ConflictDeclaration {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  conflictType  String // NONE, FAMILY, PERSONAL, SUPERVISORY, COLLEAGUE, FINANCIAL, OTHER
  details       String?
  resolution    String?
  resolvedBy    String?
  createdAt     DateTime    @default(now())
}

// ----------------------------------------------------
// 7. Assessments
// ----------------------------------------------------

model Assessment {
  id                 String    @id @default(uuid())
  vacancyId          String
  vacancy            Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  type               String // ONLINE_MCQ, ESSAY, SCENARIO, FILE_UPLOAD, OFFLINE_WRITTEN, PRACTICAL
  durationMinutes    Int       @default(60)
  opensAt            DateTime?
  closesAt           DateTime?
  passMark           Float
  maximumAttempts    Int       @default(1)
  randomizeQuestions Boolean   @default(false)
  autoSubmit         Boolean   @default(true)
  configurationJson  String?

  questions            AssessmentQuestion[]
  candidateAssessments CandidateAssessment[]
}

model AssessmentQuestion {
  id                String     @id @default(uuid())
  assessmentId      String
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionType      String // MCQ, MULTISELECT, TRUEFALSE, SHORTTEXT, LONGTEXT, FILE
  prompt            String
  optionsJson       String?
  correctAnswerJson String?
  maximumScore      Float
  displayOrder      Int        @default(0)

  answers CandidateAssessmentAnswer[]
}

model CandidateAssessment {
  id                String      @id @default(uuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        Assessment  @relation(fields: [assessmentId], references: [id])
  status            String      @default("INVITED") // INVITED, NOT_STARTED, IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED, MARKED, PASSED, FAILED
  invitedAt         DateTime    @default(now())
  startedAt         DateTime?
  submittedAt       DateTime?
  autoSubmitted     Boolean     @default(false)
  score             Float?
  passed            Boolean?
  markerUserId      String?
  markerComment     String?
  offlineRecordJson String?

  answers CandidateAssessmentAnswer[]

  @@unique([applicationId, assessmentId])
}

model CandidateAssessmentAnswer {
  id                    String              @id @default(uuid())
  candidateAssessmentId String
  candidateAssessment   CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  assessmentQuestionId  String
  assessmentQuestion    AssessmentQuestion  @relation(fields: [assessmentQuestionId], references: [id])
  answerJson            String?
  score                 Float?
  markerComment         String?

  @@unique([candidateAssessmentId, assessmentQuestionId])
}

// ----------------------------------------------------
// 8. Interviews
// ----------------------------------------------------

model Interview {
  id                    String      @id @default(uuid())
  applicationId         String
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title                 String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  timezone              String      @default("UTC")
  venue                 String?
  meetingLink           String?
  format                String      @default("VIRTUAL") // PHYSICAL, VIRTUAL, HYBRID
  status                String      @default("SCHEDULED") // SCHEDULED, CONFIRMED, RESCHEDULED, ATTENDED, DID_NOT_ATTEND, CANCELLED
  candidateResponse     String? // CONFIRMED, RESCHEDULE_REQUESTED, DECLINED
  candidateComment      String?
  instructions          String?
  attachmentFileIdsJson String?
  reminderMinutesBefore Int         @default(1440)
  panelReadyAt          DateTime?
  panelConfirmedAt      DateTime?
  panelConfirmedBy      String?
  varianceFlag          Boolean     @default(false)
  createdBy             String
  lockVersion           Int         @default(1)

  panelMembers     InterviewPanelMember[]
  questions        InterviewQuestion[]
  panelSubmissions InterviewPanelSubmission[]
}

model InterviewPanelMember {
  id              String    @id @default(uuid())
  interviewId     String
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  panelRole       String    @default("MEMBER") // CHAIR, MEMBER, HR_REP
  conflictStatus  String    @default("NONE")
  conflictComment String?

  scores     InterviewScore[]
  submission InterviewPanelSubmission?

  @@unique([interviewId, userId])
}

model InterviewQuestion {
  id               String    @id @default(uuid())
  interviewId      String
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question         String
  competency       String?
  guidance         String?
  expectedEvidence String?
  redFlags         String?
  maximumScore     Float
  commentRequired  Boolean   @default(true)
  displayOrder     Int       @default(0)

  scores InterviewScore[]
}

model InterviewScore {
  id                  String               @id @default(uuid())
  interviewId         String
  panelMemberId       String
  panelMember         InterviewPanelMember @relation(fields: [panelMemberId], references: [id], onDelete: Cascade)
  interviewQuestionId String
  interviewQuestion   InterviewQuestion    @relation(fields: [interviewQuestionId], references: [id])
  score               Float
  comment             String?

  @@unique([panelMemberId, interviewQuestionId])
}

model InterviewPanelSubmission {
  id                   String               @id @default(uuid())
  interviewId          String
  interview            Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  panelMemberId        String               @unique
  panelMember          InterviewPanelMember @relation(fields: [panelMemberId], references: [id], onDelete: Cascade)
  totalScore           Float
  recommendation       String // RECOMMENDED, RESERVE, NOT_RECOMMENDED
  submittedAt          DateTime             @default(now())
  version              Int                  @default(1)
  previousVersionsJson String               @default("[]")
  reopenedAt           DateTime?
  reopenedBy           String?
  reopenReason         String?
}

// ----------------------------------------------------
// 9. References
// ----------------------------------------------------

model Referee {
  id                     String      @id @default(uuid())
  applicationId          String
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name                   String
  organization           String
  position               String
  relationship           String
  email                  String
  phone                  String?
  preferredContactMethod String      @default("EMAIL")
  contactStatus          String      @default("READY") // READY, UNABLE_TO_CONTACT, WAIVED
  waiverReason           String?
  periodKnown            String?
  permissionToContact    Boolean     @default(true)

  requests ReferenceRequest[]
}

model ReferenceRequest {
  id                 String    @id @default(uuid())
  refereeId          String
  referee            Referee   @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  secureTokenHash    String    @unique
  expiresAt          DateTime
  sentAt             DateTime?
  reminderSentAt     DateTime?
  responseReceivedAt DateTime?
  status             String    @default("PENDING") // PENDING, SENT, COMPLETED, EXPIRED

  response ReferenceResponse?
}

model ReferenceResponse {
  id                  String           @id @default(uuid())
  referenceRequestId  String           @unique
  referenceRequest    ReferenceRequest @relation(fields: [referenceRequestId], references: [id], onDelete: Cascade)
  answersJson         String
  outcome             String // SATISFACTORY, CONCERNS, UNSATISFACTORY
  confidentialComment String?
  verifiedBy          String?
  verifiedAt          DateTime?
}

// ----------------------------------------------------
// 10. Selection & Approvals
// ----------------------------------------------------

model SelectionDecision {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  outcome       String // SELECTED, FIRST_RESERVE, SECOND_RESERVE, NOT_SELECTED
  rank          Int?
  justification String?
  overrideFlag  Boolean     @default(false)
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
}

model Approval {
  id             String              @id @default(uuid())
  resourceType   String // VACANCY, SELECTION, OFFER, WAIVER
  resourceId     String
  stage          Int                 @default(1)
  approverUserId String
  requestedBy    String?
  decision       String // PENDING, APPROVED, REJECTED, RETURNED
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lockVersion    Int                 @default(1)
  conditions     ApprovalCondition[]
}

model ApprovalCondition {
  id             String    @id @default(uuid())
  approvalId     String
  approval       Approval  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  description    String
  ownerUserId    String?
  dueAt          DateTime?
  status         String    @default("OPEN") // OPEN, EVIDENCE_SUBMITTED, SATISFIED, WAIVED
  evidenceFileId String?
  evidenceNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------
// 11. Offers
// ----------------------------------------------------

model OfferTemplate {
  id            String  @id @default(uuid())
  name          String
  candidateType String // GENERAL, CONSULTANT, INTERN
  bodyTemplate  String
  active        Boolean @default(true)
  version       Int     @default(1)
  offers        Offer[]
}

model Offer {
  id                         String         @id @default(uuid())
  applicationId              String
  application                Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerTemplateId            String?
  offerTemplate              OfferTemplate? @relation(fields: [offerTemplateId], references: [id])
  templateSnapshotJson       String?
  position                   String
  dutyStation                String
  contractType               String
  contractDuration           String?
  salary                     String
  startDate                  DateTime
  endDate                    DateTime?
  probationPeriod            String?
  reportingLine              String?
  conditions                 String?
  acceptanceDeadline         DateTime
  status                     String         @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, VIEWED, ACCEPTED, DECLINED, EXPIRED, WITHDRAWN
  offerFileId                String?
  signedFileId               String?
  sentAt                     DateTime?
  viewedAt                   DateTime?
  acceptedAt                 DateTime?
  declinedAt                 DateTime?
  candidateComment           String?
  candidateProposedStartDate DateTime?
  signatureName              String?
  signatureMethod            String?
  signatureIpAddress         String?
  signatureUserAgent         String?
  version                    Int            @default(1)
  supersedesOfferId          String?        @unique
  supersedesOffer            Offer?         @relation("OfferVersions", fields: [supersedesOfferId], references: [id])
  supersededBy               Offer?         @relation("OfferVersions")
}

// ----------------------------------------------------
// 12. Preboarding Packages & Requirements
// ----------------------------------------------------

model PreboardingPackage {
  id            String  @id @default(uuid())
  name          String
  description   String?
  candidateType String // GENERAL, HEALTH, FIELD, FINANCE, DRIVER
  roleCategory  String?
  version       Int     @default(1)
  active        Boolean @default(true)

  packageForms     PackageForm[]
  packageDocuments PackageDocumentRequirement[]
  packagePolicies  PackagePolicy[]
  packageCourses   PackageCourse[]
  packageTasks     PackageTask[]
}

model CandidatePreboarding {
  id                          String      @id @default(uuid())
  applicationId               String      @unique
  application                 Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status                      String      @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, AWAITING_HR_REVIEW, READY_TO_RESUME, COMPLETED
  overallCompletionPercentage Int         @default(0)
  readinessStatus             String      @default("NOT_READY") // NOT_READY, PENDING_CANDIDATE, PENDING_HR_REVIEW, CONDITIONALLY_READY, READY_TO_RESUME
  startedAt                   DateTime    @default(now())
  readyAt                     DateTime?
  completedAt                 DateTime?
  confirmedStartDate          DateTime?
  startDateConfirmedAt        DateTime?
  lockVersion                 Int         @default(1)

  assignedPackages       CandidatePreboardingPackage[]
  forms                  CandidatePreboardingForm[]
  documents              CandidateRequiredDocument[]
  policyAcknowledgements CandidatePolicyAcknowledgement[]
  courses                CandidateCourse[]
  tasks                  CandidatePreboardingTask[]
  infoItems              CandidateInformationItem[]
  meetings               PreboardingMeeting[]
  readinessChecks        ReadinessCheck[]
  readinessConfirmation  ReadinessConfirmation?
}

model CandidatePreboardingPackage {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  preboardingPackageId   String
  assignedBy             String
  assignedAt             DateTime             @default(now())

  @@unique([candidatePreboardingId, preboardingPackageId])
}

// ----------------------------------------------------
// 13. Preboarding Forms
// ----------------------------------------------------

model PreboardingFormTemplate {
  id               String  @id @default(uuid())
  title            String
  description      String?
  schemaJson       String
  required         Boolean @default(true)
  reviewRequired   Boolean @default(true)
  version          Int     @default(1)
  active           Boolean @default(true)
  sensitivityClass String  @default("STANDARD") // STANDARD, CONFIDENTIAL, RESTRICTED

  packageForms   PackageForm[]
  candidateForms CandidatePreboardingForm[]
}

model PackageForm {
  id                   String                  @id @default(uuid())
  preboardingPackageId String
  preboardingPackage   PreboardingPackage      @relation(fields: [preboardingPackageId], references: [id], onDelete: Cascade)
  formTemplateId       String
  formTemplate         PreboardingFormTemplate @relation(fields: [formTemplateId], references: [id])
  required             Boolean                 @default(true)
  dueOffsetDays        Int                     @default(7)
}

model CandidatePreboardingForm {
  id                     String                  @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding    @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  formTemplateId         String
  formTemplate           PreboardingFormTemplate @relation(fields: [formTemplateId], references: [id])
  responseJson           String?
  status                 String                  @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, UNDER_REVIEW, APPROVED, RETURNED, WAIVED
  submittedAt            DateTime?
  reviewedBy             String?
  reviewedAt             DateTime?
  returnReason           String?
  required               Boolean                 @default(true)
  dueAt                  DateTime?
  templateSnapshotJson   String?

  @@unique([candidatePreboardingId, formTemplateId])
}

// ----------------------------------------------------
// 14. Document Requirements
// ----------------------------------------------------

model DocumentRequirement {
  id               String  @id @default(uuid())
  name             String
  description      String?
  documentType     String
  required         Boolean @default(true)
  allowedFileTypes String  @default("pdf,jpg,png")
  maximumFileSize  Int     @default(5242880)
  expiryRequired   Boolean @default(false)
  reviewRequired   Boolean @default(true)
  sensitivityClass String  @default("STANDARD")
  active           Boolean @default(true)

  packageDocuments PackageDocumentRequirement[]
  candidateDocs    CandidateRequiredDocument[]
}

model PackageDocumentRequirement {
  id                    String              @id @default(uuid())
  preboardingPackageId  String
  preboardingPackage    PreboardingPackage  @relation(fields: [preboardingPackageId], references: [id], onDelete: Cascade)
  documentRequirementId String
  documentRequirement   DocumentRequirement @relation(fields: [documentRequirementId], references: [id])
  required              Boolean             @default(true)
  dueOffsetDays         Int                 @default(7)
}

model CandidateRequiredDocument {
  id                      String                             @id @default(uuid())
  candidatePreboardingId  String
  candidatePreboarding    CandidatePreboarding               @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  documentRequirementId   String
  documentRequirement     DocumentRequirement                @relation(fields: [documentRequirementId], references: [id])
  fileAssetId             String?
  expiryDate              DateTime?
  status                  String                             @default("NOT_SUBMITTED") // NOT_SUBMITTED, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, RESUBMISSION_REQUIRED, EXPIRED, WAIVED
  submittedAt             DateTime?
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectionReason         String?
  versionNumber           Int                                @default(1)
  required                Boolean                            @default(true)
  dueAt                   DateTime?
  requirementSnapshotJson String?
  versions                CandidateRequiredDocumentVersion[]

  @@unique([candidatePreboardingId, documentRequirementId])
}

model CandidateRequiredDocumentVersion {
  id                          String                    @id @default(uuid())
  candidateRequiredDocumentId String
  candidateRequiredDocument   CandidateRequiredDocument @relation(fields: [candidateRequiredDocumentId], references: [id], onDelete: Cascade)
  versionNumber               Int
  fileAssetId                 String
  expiryDate                  DateTime?
  status                      String
  submittedAt                 DateTime?
  archivedAt                  DateTime                  @default(now())

  @@unique([candidateRequiredDocumentId, versionNumber])
}

// ----------------------------------------------------
// 15. Policies & Signatures
// ----------------------------------------------------

model PolicyDocument {
  id                    String   @id @default(uuid())
  title                 String
  category              String // CODE_OF_CONDUCT, SAFEGUARDING, PSEA, CONFIDENTIALITY, DATA_PROTECTION, ICT
  version               Int      @default(1)
  effectiveDate         DateTime
  fileAssetId           String?
  summary               String?
  acknowledgementMethod String   @default("SIGNATURE") // ACKNOWLEDGE, TYPED_NAME, DRAWN_SIGNATURE, UPLOAD_SIGNED
  signatureMethod       String   @default("DIGITAL")
  active                Boolean  @default(true)

  packagePolicies   PackagePolicy[]
  candidatePolicies CandidatePolicyAcknowledgement[]
}

model PackagePolicy {
  id                   String             @id @default(uuid())
  preboardingPackageId String
  preboardingPackage   PreboardingPackage @relation(fields: [preboardingPackageId], references: [id], onDelete: Cascade)
  policyDocumentId     String
  policyDocument       PolicyDocument     @relation(fields: [policyDocumentId], references: [id])
  required             Boolean            @default(true)
  dueOffsetDays        Int                @default(7)
}

model CandidatePolicyAcknowledgement {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  policyDocumentId       String
  policyDocument         PolicyDocument       @relation(fields: [policyDocumentId], references: [id])
  status                 String               @default("ASSIGNED") // ASSIGNED, VIEWED, ACKNOWLEDGED, SIGNED, APPROVED, REJECTED, SUPERSEDED, WAIVED
  viewedAt               DateTime?
  acknowledgedAt         DateTime?
  signedAt               DateTime?
  signatureMethod        String?
  signatureData          String?
  signedFileId           String?
  reviewedBy             String?
  reviewedAt             DateTime?
  required               Boolean              @default(true)
  signatureIpAddress     String?
  signatureUserAgent     String?
  dueAt                  DateTime?
  policySnapshotJson     String?

  @@unique([candidatePreboardingId, policyDocumentId])
}

// ----------------------------------------------------
// 16. Compulsory Courses
// ----------------------------------------------------

model Course {
  id                       String  @id @default(uuid())
  title                    String
  description              String?
  category                 String // CORE, HEALTH, FINANCE, DRIVER, MEAL, MANAGER
  version                  Int     @default(1)
  learningObjectives       String?
  estimatedDurationMinutes Int     @default(30)
  passMark                 Float   @default(80.0)
  allowedAttempts          Int     @default(3)
  certificateEnabled       Boolean @default(true)
  active                   Boolean @default(true)

  contents         CourseContent[]
  quizQuestions    CourseQuizQuestion[]
  packageCourses   PackageCourse[]
  candidateCourses CandidateCourse[]
}

model CourseContent {
  id           String  @id @default(uuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentType  String // READING, VIDEO, SLIDES, ATTACHMENT
  title        String
  content      String?
  fileAssetId  String?
  displayOrder Int     @default(0)

  candidateProgress CandidateCourseContentProgress[]
}

model CourseQuizQuestion {
  id                String @id @default(uuid())
  courseId          String
  course            Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionType      String // MCQ, MULTISELECT, TRUEFALSE, SHORTTEXT
  question          String
  optionsJson       String
  correctAnswerJson String
  score             Float  @default(1.0)
  displayOrder      Int    @default(0)
}

model PackageCourse {
  id                   String             @id @default(uuid())
  preboardingPackageId String
  preboardingPackage   PreboardingPackage @relation(fields: [preboardingPackageId], references: [id], onDelete: Cascade)
  courseId             String
  course               Course             @relation(fields: [courseId], references: [id])
  required             Boolean            @default(true)
  timing               String             @default("BEFORE_RESUMPTION") // BEFORE_RESUMPTION, FIRST_WEEK, FIRST_MONTH, OPTIONAL
  dueOffsetDays        Int                @default(7)
}

model CandidateCourse {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  courseId               String
  course                 Course               @relation(fields: [courseId], references: [id])
  status                 String               @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, QUIZ_PENDING, COMPLETED, FAILED, WAIVED
  assignedAt             DateTime             @default(now())
  dueAt                  DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  score                  Float?
  attempts               Int                  @default(0)
  certificateFileId      String?
  required               Boolean              @default(true)
  courseSnapshotJson     String?

  courseAttempts  CandidateCourseAttempt[]
  contentProgress CandidateCourseContentProgress[]

  @@unique([candidatePreboardingId, courseId])
}

model CandidateCourseContentProgress {
  id                String          @id @default(uuid())
  candidateCourseId String
  candidateCourse   CandidateCourse @relation(fields: [candidateCourseId], references: [id], onDelete: Cascade)
  courseContentId   String
  courseContent     CourseContent   @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  completedAt       DateTime        @default(now())
  evidenceJson      String?

  @@unique([candidateCourseId, courseContentId])
  @@index([candidateCourseId, completedAt])
}

model CandidateCourseAttempt {
  id                String          @id @default(uuid())
  candidateCourseId String
  candidateCourse   CandidateCourse @relation(fields: [candidateCourseId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  startedAt         DateTime        @default(now())
  submittedAt       DateTime?
  score             Float?
  passed            Boolean?
  answersJson       String?

  @@unique([candidateCourseId, attemptNumber])
}

// ----------------------------------------------------
// 17. Pre-resumption Tasks & Info
// ----------------------------------------------------

model PreboardingTaskTemplate {
  id               String  @id @default(uuid())
  title            String
  description      String?
  category         String  @default("GENERAL")
  required         Boolean @default(true)
  reviewRequired   Boolean @default(false)
  evidenceRequired Boolean @default(false)
  dependencyJson   String?
  active           Boolean @default(true)
  version          Int     @default(1)

  packageTasks   PackageTask[]
  candidateTasks CandidatePreboardingTask[]
}

model PackageTask {
  id                   String                  @id @default(uuid())
  preboardingPackageId String
  preboardingPackage   PreboardingPackage      @relation(fields: [preboardingPackageId], references: [id], onDelete: Cascade)
  taskTemplateId       String
  taskTemplate         PreboardingTaskTemplate @relation(fields: [taskTemplateId], references: [id])
  required             Boolean                 @default(true)
  dueOffsetDays        Int                     @default(7)
}

model CandidatePreboardingTask {
  id                     String                  @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding    @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  taskTemplateId         String
  taskTemplate           PreboardingTaskTemplate @relation(fields: [taskTemplateId], references: [id])
  status                 String                  @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, APPROVED, RETURNED, COMPLETED, WAIVED
  assignedAt             DateTime                @default(now())
  dueAt                  DateTime?
  submittedAt            DateTime?
  completedAt            DateTime?
  candidateComment       String?
  evidenceFileId         String?
  reviewerComment        String?
  reviewedBy             String?
  required               Boolean                 @default(true)
  taskSnapshotJson       String?

  @@unique([candidatePreboardingId, taskTemplateId])
}

model CandidateInformationItem {
  id                      String               @id @default(uuid())
  candidatePreboardingId  String
  candidatePreboarding    CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  category                String // REPORTING, TRAVEL, GENERAL
  title                   String
  content                 String
  acknowledgementRequired Boolean              @default(true)
  acknowledgedAt          DateTime?
}

// ----------------------------------------------------
// 18. Meetings & Orientation
// ----------------------------------------------------

model PreboardingMeeting {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  facilitatorUserId      String?
  scheduledStart         DateTime
  scheduledEnd           DateTime
  timezone               String               @default("UTC")
  venue                  String?
  meetingLink            String?
  required               Boolean              @default(true)
  status                 String               @default("SCHEDULED") // SCHEDULED, CONFIRMED, ATTENDED, MISSED, CANCELLED, WAIVED
  candidateResponse      String?
  attendanceComment      String?
}

// ----------------------------------------------------
// 19. Readiness, Resumption & ERP Transfer
// ----------------------------------------------------

model ReadinessCheck {
  id                     String               @id @default(uuid())
  candidatePreboardingId String
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  checkType              String // OFFER_ACCEPTED, ID_APPROVED, QUALIFICATION_APPROVED, FORMS_APPROVED, POLICIES_SIGNED, COURSES_COMPLETED, TASKS_COMPLETED, REFERENCES_SATISFACTORY, HR_REVIEW
  required               Boolean              @default(true)
  status                 String               @default("PENDING") // PENDING, PASSED, FAILED, WAIVED
  sourceResourceType     String?
  sourceResourceId       String?
  waivedBy               String?
  waiverReason           String?
  waivedAt               DateTime?
  reviewedAt             DateTime?

  @@unique([candidatePreboardingId, checkType])
}

model ReadinessConfirmation {
  id                     String               @id @default(uuid())
  candidatePreboardingId String               @unique
  candidatePreboarding   CandidatePreboarding @relation(fields: [candidatePreboardingId], references: [id], onDelete: Cascade)
  confirmedBy            String
  confirmedAt            DateTime             @default(now())
  status                 String               @default("CONFIRMED")
  summaryJson            String
  comment                String?
}

model ResumptionRecord {
  id                     String      @id @default(uuid())
  applicationId          String      @unique
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plannedStartDate       DateTime
  actualStartDate        DateTime?
  reportingLocation      String
  outcome                String      @default("PENDING") // RESUMED, DID_NOT_RESUME, POSTPONED, WITHDRAWN
  confirmedBy            String?
  supervisorConfirmation Boolean     @default(false)
  comment                String?
}

model ERPTransferRecord {
  id                 String      @id @default(uuid())
  applicationId      String      @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  erpPersonnelNumber String      @unique
  createdInErpAt     DateTime    @default(now())
  recordedBy         String
  comment            String?
  status             String      @default("CREATED_IN_ERP") // CREATED_IN_ERP, CONFIRMED
}

// ----------------------------------------------------
// 20. Messaging, Notifications & Audit
// ----------------------------------------------------

model MessageThread {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject       String
  category      String      @default("GENERAL")
  restricted    Boolean     @default(false)

  messages Message[]
}

model Message {
  id              String        @id @default(uuid())
  messageThreadId String
  messageThread   MessageThread @relation(fields: [messageThreadId], references: [id], onDelete: Cascade)
  senderUserId    String
  sender          User          @relation(fields: [senderUserId], references: [id])
  body            String
  fileAssetId     String?
  sentAt          DateTime      @default(now())
  readAt          DateTime?
}

model Notification {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  title                String
  body                 String
  deliveryChannelsJson String    @default("[\"IN_APP\",\"EMAIL\"]")
  status               String    @default("UNREAD") // UNREAD, READ
  sentAt               DateTime  @default(now())
  readAt               DateTime?
}

model AuditLog {
  id                String   @id @default(uuid())
  actorUserId       String?
  actor             User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action            String
  resourceType      String
  resourceId        String
  previousValueJson String?
  newValueJson      String?
  reason            String?
  ipAddress         String?
  userAgent         String?
  requestId         String?
  previousHash      String?
  entryHash         String?
  createdAt         DateTime @default(now())
}

model AuditChainHead {
  id        String   @id
  headHash  String?
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model FraudReport {
  id              String    @id @default(uuid())
  referenceNumber String?   @unique
  suspectContact  String
  incidentDetails String
  reporterEmail   String?
  status          String    @default("RECEIVED") // RECEIVED, UNDER_REVIEW, ACTIONED, DISMISSED
  triagedBy       String?
  triagedAt       DateTime?
  triageNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  valueJson   String
  description String?
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// 22. Recruitment operating system
// ----------------------------------------------------

model WorkflowDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  resourceType String
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions WorkflowVersion[]
}

model WorkflowVersion {
  id                   String             @id @default(uuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  version              Int
  status               String             @default("DRAFT") // DRAFT, ACTIVE, RETIRED
  publishedBy          String?
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())

  transitions WorkflowTransitionRule[]

  @@unique([workflowDefinitionId, version])
}

model WorkflowTransitionRule {
  id                    String          @id @default(uuid())
  workflowVersionId     String
  workflowVersion       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromStatus            String
  toStatus              String
  requiredPermission    String
  gateConfigurationJson String          @default("{}")
  makerChecker          Boolean         @default(false)
  displayOrder          Int             @default(0)

  @@unique([workflowVersionId, fromStatus, toStatus])
}

model SlaPolicy {
  id                     String   @id @default(uuid())
  code                   String   @unique
  name                   String
  workType               String
  priority               String   @default("NORMAL")
  targetMinutes          Int
  warningMinutes         Int
  escalationRole         String?
  escalationAfterMinutes Int?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model WorkItem {
  id                     String    @id @default(uuid())
  deduplicationKey       String    @unique
  workType               String
  title                  String
  description            String?
  status                 String    @default("OPEN") // OPEN, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED
  priority               String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedUserId         String?
  assignedUser           User?     @relation("WorkItemAssignee", fields: [assignedUserId], references: [id])
  assignedRole           String?
  createdBy              String?
  creator                User?     @relation("WorkItemCreator", fields: [createdBy], references: [id])
  resourceType           String
  resourceId             String
  vacancyId              String?
  applicationId          String?
  candidatePreboardingId String?
  dueAt                  DateTime?
  warningAt              DateTime?
  escalatedAt            DateTime?
  escalationLevel        Int       @default(0)
  blockedReason          String?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  lockVersion            Int       @default(1)

  @@unique([workType, resourceType, resourceId, assignedUserId])
  @@index([assignedUserId, status, dueAt])
  @@index([assignedRole, status, dueAt])
  @@index([vacancyId, status])
  @@index([applicationId, status])
}

model TalentPool {
  id          String   @id @default(uuid())
  name        String
  description String?
  poolType    String   @default("GENERAL") // GENERAL, ROLE, SKILL, RESERVE, ALUMNI
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TalentPoolMember[]
}

model TalentPoolMember {
  id                  String           @id @default(uuid())
  talentPoolId        String
  talentPool          TalentPool       @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  addedBy             String
  addedByUser         User             @relation("TalentPoolAddedBy", fields: [addedBy], references: [id])
  sourceApplicationId String?
  status              String           @default("ACTIVE") // ACTIVE, CONTACTED, CONVERTED, REMOVED
  tagsJson            String           @default("[]")
  notes               String?
  consentExpiresAt    DateTime?
  addedAt             DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([talentPoolId, candidateId])
  @@index([candidateId, status])
}

model AccommodationRequest {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestType   String
  details       String
  status        String      @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, PARTIALLY_APPROVED, DECLINED, FULFILLED
  confidential  Boolean     @default(true)
  requestedAt   DateTime    @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  decision      String?
  fulfilledAt   DateTime?

  @@index([applicationId, status])
}

model IntegrationConnection {
  id                String    @id @default(uuid())
  provider          String
  connectionType    String // CALENDAR, SMS, ESIGNATURE, JOB_BOARD, REFERENCE
  displayName       String
  status            String    @default("DISCONNECTED")
  configurationJson String    @default("{}")
  secretReference   String?
  lastHealthCheckAt DateTime?
  lastHealthStatus  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, connectionType])
}

model ConfigurationChangeRequest {
  id              String    @id @default(uuid())
  changeType      String // SLA_POLICY_UPDATE, WORKFLOW_PUBLISH, INTEGRATION_UPDATE
  resourceId      String
  proposedJson    String
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, APPLIED, FAILED
  requestedBy     String
  requestedAt     DateTime  @default(now())
  decidedBy       String?
  decidedAt       DateTime?
  decisionComment String?
  appliedAt       DateTime?
  scheduledFor    DateTime?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  previousJson    String?
  lockVersion     Int       @default(1)

  @@index([status, requestedAt])
}

model AutomationControl {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  description      String
  mode             String    @default("ACTIVE") // ACTIVE, PREVIEW, PAUSED
  settingsJson     String    @default("{}")
  updatedBy        String
  lastPreviewAt    DateTime?
  lastOverriddenAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AutomationActionLog {
  id             String   @id @default(uuid())
  automationCode String
  action         String
  targetType     String
  targetId       String
  status         String // PREVIEWED, COMPLETED, SKIPPED, OVERRIDDEN, FAILED
  detailsJson    String   @default("{}")
  actorUserId    String?
  createdAt      DateTime @default(now())

  @@index([automationCode, createdAt])
  @@index([targetType, targetId])
}

model BulkActionRun {
  id              String    @id @default(uuid())
  actionType      String
  requestedBy     String
  requestedCount  Int
  eligibleCount   Int
  failedCount     Int
  status          String // PREVIEWED, COMPLETED, PARTIAL, FAILED
  requestJson     String
  resultJson      String
  reversibleUntil DateTime?
  reversedAt      DateTime?
  reversedBy      String?
  createdAt       DateTime  @default(now())

  @@index([requestedBy, createdAt])
  @@index([actionType, createdAt])
}

model CandidateMergeReview {
  id                   String    @id @default(uuid())
  primaryCandidateId   String
  duplicateCandidateId String
  requestedBy          String
  status               String    @default("DRAFT") // DRAFT, APPROVED, MERGED, REJECTED
  previewJson          String
  survivorChoicesJson  String    @default("{}")
  reason               String
  approvedBy           String?
  approvedAt           DateTime?
  mergedAt             DateTime?
  lockVersion          Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([primaryCandidateId, duplicateCandidateId])
  @@index([status, createdAt])
}

model NotificationTemplate {
  id           String  @id @default(uuid())
  code         String  @unique
  subject      String
  bodyTemplate String
  active       Boolean @default(true)
  version      Int     @default(1)
}

model ContractType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
}

model DocumentType {
  id               String  @id @default(uuid())
  code             String  @unique
  name             String
  allowedFileTypes String  @default("pdf,jpg,png")
  maximumFileSize  Int     @default(5242880)
  active           Boolean @default(true)
}

// ----------------------------------------------------
// 21. Reliability, Governance & Case Management
// ----------------------------------------------------

model OutboxMessage {
  id               String    @id @default(uuid())
  channel          String // EMAIL, WEBHOOK
  recipient        String
  subject          String?
  applicationId    String?
  payloadJson      String
  status           String    @default("PENDING") // PENDING, PROCESSING, DELIVERED, FAILED, DEAD_LETTER
  attempts         Int       @default(0)
  maximumAttempts  Int       @default(5)
  availableAt      DateTime  @default(now())
  lockedAt         DateTime?
  leaseOwner       String?
  deliveredAt      DateTime?
  lastError        String?
  deduplicationKey String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, availableAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  scope        String
  key          String
  actorUserId  String?
  requestHash  String
  responseJson String?
  statusCode   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key, actorUserId])
  @@index([expiresAt])
}

model LegalHold {
  id           String    @id @default(uuid())
  resourceType String
  resourceId   String
  reason       String
  status       String    @default("ACTIVE") // ACTIVE, RELEASED
  placedBy     String
  placedAt     DateTime  @default(now())
  releasedBy   String?
  releasedAt   DateTime?

  @@index([resourceType, resourceId, status])
}

model RetentionRun {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  policyVersion String
  summaryJson   String?
  evidenceHash  String?
  error         String?
}

model AccessReview {
  id                String    @id @default(uuid())
  userId            String
  reviewerUserId    String
  status            String    @default("PENDING") // PENDING, APPROVED, CHANGES_REQUIRED, COMPLETED
  rolesSnapshotJson String
  decisionComment   String?
  dueAt             DateTime
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, dueAt])
}

model ComplaintCase {
  id                    String                @id @default(uuid())
  referenceNumber       String                @unique
  reporterUserId        String?
  reporterEmail         String?
  applicationId         String?
  application           Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  category              String // COMPLAINT, APPEAL, SAFEGUARDING, FRAUD, ACCOMMODATION, PRIVACY, OTHER
  subject               String
  description           String
  confidentiality       String                @default("CONFIDENTIAL")
  status                String                @default("RECEIVED") // RECEIVED, TRIAGED, INVESTIGATING, AWAITING_INFORMATION, RESOLVED, CLOSED
  priority              String                @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  assignedToUserId      String?
  acknowledgementSentAt DateTime?
  dueAt                 DateTime?
  resolution            String?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lockVersion           Int                   @default(1)
  comments              ComplaintComment[]
  attachments           ComplaintAttachment[]

  @@index([status, priority, dueAt])
  @@index([reporterUserId])
}

model ComplaintComment {
  id              String        @id @default(uuid())
  complaintCaseId String
  complaintCase   ComplaintCase @relation(fields: [complaintCaseId], references: [id], onDelete: Cascade)
  authorUserId    String?
  body            String
  internalOnly    Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

model ComplaintAttachment {
  id              String        @id @default(uuid())
  complaintCaseId String
  complaintCase   ComplaintCase @relation(fields: [complaintCaseId], references: [id], onDelete: Cascade)
  fileAssetId     String
  uploadedBy      String?
  createdAt       DateTime      @default(now())
}

model EntityVersion {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  version      Int
  snapshotJson String
  changeReason String?
  createdBy    String
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, version])
}

model EligibilityRule {
  id             String   @id @default(uuid())
  vacancyId      String
  ruleType       String // MINIMUM_EXPERIENCE, REQUIRED_LICENCE, REQUIRED_ANSWER
  field          String?
  operator       String
  expectedJson   String
  failureMessage String
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([vacancyId, active])
}

model EligibilityEvaluation {
  id               String    @id @default(uuid())
  applicationId    String
  ruleVersionJson  String
  resultJson       String
  suggestedOutcome String // ELIGIBLE, REVIEW_REQUIRED, POSSIBLY_INELIGIBLE
  humanDecision    String?
  decidedBy        String?
  decisionReason   String?
  evaluatedAt      DateTime  @default(now())
  decidedAt        DateTime?

  @@index([applicationId, evaluatedAt])
}

model OperationalEvent {
  id           String    @id @default(uuid())
  eventType    String
  severity     String    @default("INFO")
  resourceType String?
  resourceId   String?
  detailsJson  String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType, createdAt])
  @@index([resolvedAt, severity])
}

model JobRun {
  id          String    @id @default(uuid())
  jobName     String
  status      String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summaryJson String?
  error       String?

  @@index([jobName, startedAt])
}

model JobLease {
  jobName     String   @id
  leaseOwner  String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model RateLimitBucket {
  keyHash     String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model ScheduledReport {
  id             String    @id @default(uuid())
  userId         String
  reportType     String
  format         String    @default("xlsx")
  frequency      String // DAILY, WEEKLY, MONTHLY
  recipientEmail String
  nextRunAt      DateTime
  lastRunAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, nextRunAt])
  @@index([userId])
}
