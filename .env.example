NODE_ENV=development
# The Prisma schema targets PostgreSQL. A SQLite "file:" URL will not work.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/frad_dev"
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-different-32-character-secret
STORAGE_ENCRYPTION_KEY=replace-with-an-independent-32-character-storage-key
OUTBOX_ENCRYPTION_KEY=replace-with-an-independent-32-character-outbox-key
CRON_SECRET=replace-with-a-random-cron-secret
HEALTH_SECRET=replace-with-a-random-monitoring-secret
SEED_PASSWORD=replace-with-a-strong-local-demo-password
# One-off production admin bootstrap (scripts/bootstrap-production-admin.ts).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated domains scheduled reports may be emailed to. Defaults to the
# requesting user's own email domain.
REPORT_RECIPIENT_DOMAINS=
STORAGE_LOCAL_PATH=.storage
STORAGE_DRIVER=local
# For production private S3-compatible storage, set STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The conventional AWS names are accepted as an alternative to the S3_* pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
VIRUS_SCAN_DRIVER=development
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Configure only when a trusted reverse proxy overwrites this header.
TRUSTED_CLIENT_IP_HEADER=

# SMTP is optional in local development; without it email is logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FRAD Recruitment <no-reply@frad.org>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
OUTBOX_CONCURRENCY=5

# Optional OpenID Connect staff SSO. Existing active staff accounts are linked by verified email.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAIN=
OIDC_TIMEOUT_MS=10000

# Automatic sign-in lockout (see lib/lockout.ts).
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=30

# Display formatting. Without these, server-rendered dates follow the host's
# timezone, which can render a closing date a day early on a UTC container.
NEXT_PUBLIC_DISPLAY_TIME_ZONE=Africa/Lagos
NEXT_PUBLIC_DISPLAY_LOCALE=en-GB

# Operational tuning.
VIRUS_RESCAN_BATCH_SIZE=25
INSIGHTS_WINDOW_DAYS=365
HEALTH_JOB_STALE_MINUTES=60
# Set to false to build without Next.js standalone output (Docker needs it on).
NEXT_OUTPUT_STANDALONE=true

# End-to-end tests. Both the Playwright harness and tests/e2e/helpers.ts read
# this single name; E2E_CANDIDATE_PASSWORD / E2E_HR_PASSWORD are not read.
E2E_TEST_PASSWORD=
E2E_BASE_URL=
