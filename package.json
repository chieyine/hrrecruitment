{
  "name": "frad-recruitment-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:postgres": "npm run db:postgres:schema && prisma generate --schema prisma/postgresql/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:bootstrap-admin": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/bootstrap-production-admin.ts",
    "db:postgres:schema": "node scripts/generate-postgres-schema.mjs",
    "db:postgres:validate": "npm run db:postgres:schema && DATABASE_URL=postgresql://validation:validation@localhost:5432/validation prisma validate --schema prisma/postgresql/schema.prisma",
    "db:postgres:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "audit:inventory": "node scripts/generate-file-audit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
