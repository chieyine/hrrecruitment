NODE_ENV=production
DATABASE_URL=postgresql://frad:replace-me@postgres:5432/frad_recruitment?schema=public
# Use a separate schema-owner/migration principal in production.
DATABASE_MIGRATION_URL=postgresql://frad_migrator:replace-me@postgres:5432/frad_recruitment?schema=public
APP_URL=https://recruitment.example.org
JWT_SECRET=replace-with-a-random-64-character-secret
SESSION_SECRET=replace-with-an-independent-random-64-character-secret
STORAGE_ENCRYPTION_KEY=replace-with-an-independent-random-64-character-key
OUTBOX_ENCRYPTION_KEY=replace-with-an-independent-random-64-character-key
CRON_SECRET=replace-with-an-independent-random-secret
HEALTH_SECRET=replace-with-an-independent-monitoring-secret
STORAGE_DRIVER=s3
S3_BUCKET=frad-recruitment-private
S3_REGION=eu-west-1
S3_KMS_KEY_ID=
VIRUS_SCAN_DRIVER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
TRUSTED_CLIENT_IP_HEADER=x-real-ip
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FRAD Recruitment <no-reply@example.org>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
OUTBOX_CONCURRENCY=5
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAIN=
